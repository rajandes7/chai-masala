---
import '../styles/global.css';
import { site, nav } from '../config';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string; // absolute or site-relative URL for OG; falls back to /og.png
  type?: 'website' | 'article';
  pubDate?: Date;
}
const { title, description = site.description, image, type = 'website', pubDate } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${site.tagline}`;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL(image ?? url('og.png'), Astro.site);
const here = Astro.url.pathname.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#3b2416" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
    <link rel="apple-touch-icon" href={url('apple-touch-icon.png')} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <link rel="alternate" type="application/rss+xml" title={site.name} href={url('rss.xml')} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    {pubDate && <meta property="article:published_time" content={pubDate.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
  </head>
  <body>
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-white focus:px-4 focus:py-2 focus:rounded">Skip to content</a>
    <header class="border-b border-cream-deep">
      <nav class="mx-auto max-w-3xl px-4 sm:px-6 h-14 flex items-center justify-between gap-4" aria-label="Main">
        <a href={url()} class="font-display font-bold text-xl">{site.name}</a>
        <ul class="flex gap-4 sm:gap-6 text-sm font-medium">
          {nav.map((n) => {
            const href = url(n.href);
            const current = here === href || here.startsWith(`${href}/`);
            return <li><a href={href} aria-current={current ? 'page' : undefined} class:list={['hover:text-cinnamon py-1', current && 'text-cinnamon border-b-2 border-cinnamon']}>{n.label}</a></li>;
          })}
        </ul>
      </nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="text-chai-soft text-sm border-t border-cream-deep mt-8">
      <div class="mx-auto max-w-3xl px-4 sm:px-6 py-6 flex flex-wrap justify-between gap-3">
        <span>© {new Date().getFullYear()} {site.name}</span>
        <span class="flex gap-5">
          <a href={`mailto:${site.contactEmail}`} class="hover:text-cinnamon">Contact</a>
          <a href={url('rss.xml')} class="hover:text-cinnamon">RSS</a>
        </span>
      </div>
    </footer>
  </body>
</html>
