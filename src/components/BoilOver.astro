---
// Minimal looping illustration: a pot of chai, the foam rises, it spills over, heat comes down. Pure SVG + CSS.
---
<svg class="boilover" viewBox="0 0 400 300" role="img" aria-label="Illustration: a cute face on a pot of chai smiles, then looks shocked as the chai boils over">
  <!-- steam -->
  <g class="steam" fill="none" stroke="#6b4a34" stroke-width="3" stroke-linecap="round" opacity=".5">
    <path class="s1" d="M170 44c-8-10 8-16 0-28"/>
    <path class="s2" d="M200 34c-8-10 8-16 0-28"/>
    <path class="s3" d="M230 44c-8-10 8-16 0-28"/>
  </g>

  <!-- flames + grate -->
  <g class="flames" fill="#2f6fd6">
    <path class="f f1" d="M140 262c-9-8-2-16 0-24 3 8 9 14 0 24z"/>
    <path class="f f2" d="M170 262c-9-8-2-16 0-24 3 8 9 14 0 24z" fill="#7fb8ff"/>
    <path class="f f3" d="M200 262c-9-8-2-16 0-24 3 8 9 14 0 24z"/>
    <path class="f f4" d="M230 262c-9-8-2-16 0-24 3 8 9 14 0 24z" fill="#7fb8ff"/>
    <path class="f f5" d="M260 262c-9-8-2-16 0-24 3 8 9 14 0 24z"/>
  </g>
  <rect x="80" y="264" width="240" height="6" rx="3" fill="#3b2416"/>

  <!-- foam, behind the pot so it rises out of the rim -->
  <g class="foam">
    <path d="M124 112C122 72 160 58 200 58s78 14 76 54z" fill="#e6c08a"/>
    <circle cx="160" cy="84" r="7" fill="#f3dcb4"/><circle cx="196" cy="74" r="9" fill="#f3dcb4"/>
    <circle cx="236" cy="86" r="6" fill="#f3dcb4"/><circle cx="214" cy="96" r="5" fill="#f3dcb4"/>
  </g>

  <!-- spill running down the outside -->
  <g fill="none" stroke="#e6c08a" stroke-linecap="round">
    <path class="spill sp1" pathLength="1" d="M118 114c-10 30-2 66-8 104" stroke-width="12"/>
    <path class="spill sp2" pathLength="1" d="M282 114c10 34 4 70 9 120" stroke-width="12"/>
    <path class="spill sp3" pathLength="1" d="M258 114c4 20 0 44 3 66" stroke-width="8"/>
  </g>
  <circle class="drop d1" cx="110" cy="224" r="5" fill="#e6c08a"/>
  <circle class="drop d2" cx="291" cy="240" r="5" fill="#e6c08a"/>

  <!-- pot: body 120-280 wide, centered on x=200 -->
  <rect x="290" y="132" width="58" height="12" rx="6" fill="#5a3a28"/>
  <rect x="92" y="134" width="30" height="10" rx="5" fill="#5a3a28"/>
  <path d="M120 116h160v110a16 16 0 0 1-16 16H136a16 16 0 0 1-16-16z" fill="#7a5238"/>
  <rect x="112" y="108" width="176" height="12" rx="6" fill="#9a6f4c"/>
  <rect x="134" y="134" width="10" height="84" rx="5" fill="#fbf4e6" opacity=".14"/>

  <!-- the face, centered on the pot's chamber (x=200, y=178): happy until the chai overflows -->
  <g class="face">
    <ellipse cx="158" cy="192" rx="10" ry="6" fill="#e58e6e" opacity=".6"/>
    <ellipse cx="242" cy="192" rx="10" ry="6" fill="#e58e6e" opacity=".6"/>
    <g class="calm" fill="none" stroke="#2a160b" stroke-width="4.5" stroke-linecap="round">
      <path d="M168 176q8-10 16 0M216 176q8-10 16 0"/>
      <path d="M187 192q13 11 26 0"/>
    </g>
    <g class="shock">
      <circle cx="176" cy="172" r="12" fill="#fff"/><circle cx="224" cy="172" r="12" fill="#fff"/>
      <circle cx="176" cy="172" r="4.5" fill="#2a160b"/><circle cx="224" cy="172" r="4.5" fill="#2a160b"/>
      <path d="M164 152l24-4M212 148l24 4" fill="none" stroke="#2a160b" stroke-width="4.5" stroke-linecap="round"/>
      <ellipse cx="200" cy="198" rx="9" ry="12" fill="#2a160b"/>
    </g>
  </g>
</svg>

<style>
  .boilover { width: 100%; height: auto; display: block; overflow: visible; }

  .face { transform-box: view-box; transform-origin: 200px 178px; animation: boing 7s linear infinite; }
  .calm { animation: calm 7s linear infinite; }
  .shock { opacity: 0; animation: shock 7s linear infinite; }
  .foam { transform-box: view-box; transform-origin: 200px 112px; animation: foam 7s ease-in-out infinite; }
  .spill { stroke-dasharray: 1; stroke-dashoffset: 1; animation: spill 7s ease-in infinite; }
  .sp2 { animation-delay: .25s; } .sp3 { animation-delay: .5s; }
  .drop { opacity: 0; animation: drop 7s ease-in infinite; }
  .d2 { animation-delay: .6s; }
  .f { transform-box: fill-box; transform-origin: 50% 100%; animation: flicker .7s ease-in-out infinite alternate; }
  .f2 { animation-delay: .15s; } .f3 { animation-delay: .3s; } .f4 { animation-delay: .1s; } .f5 { animation-delay: .25s; }
  .steam path { animation: steam 3s ease-in-out infinite; }
  .s2 { animation-delay: 1s; } .s3 { animation-delay: 2s; }

  @keyframes foam {
    0%, 28% { transform: scaleY(0); }
    46% { transform: scaleY(1); }
    54% { transform: scaleY(.88); }
    62%, 84% { transform: scaleY(1); }
    100% { transform: scaleY(0); }
  }
  @keyframes spill {
    0%, 48% { stroke-dashoffset: 1; opacity: 1; }
    72%, 88% { stroke-dashoffset: 0; opacity: 1; }
    100% { stroke-dashoffset: 0; opacity: 0; }
  }
  @keyframes drop {
    0%, 66% { opacity: 0; transform: translateY(0); }
    70% { opacity: 1; }
    86% { opacity: 1; transform: translateY(34px); }
    92%, 100% { opacity: 0; transform: translateY(34px); }
  }

  /* squash, then spring big and wobble about the face's center */
  @keyframes boing {
    0%, 42% { transform: scale(1) rotate(0); animation-timing-function: ease-in; }
    44.5% { transform: scale(.9, .94) rotate(0); animation-timing-function: cubic-bezier(.2, 1.6, .4, 1); }
    48% { transform: scale(1.3) rotate(-9deg); animation-timing-function: ease-in-out; }
    52% { transform: scale(.95) rotate(7deg); animation-timing-function: ease-in-out; }
    56% { transform: scale(1.18) rotate(-5deg); animation-timing-function: ease-in-out; }
    60% { transform: scale(1.02) rotate(3deg); animation-timing-function: ease-in-out; }
    64% { transform: scale(1.12) rotate(-1.5deg); animation-timing-function: ease-in-out; }
    68%, 84% { transform: scale(1.08) rotate(0); animation-timing-function: ease-in-out; }
    94%, 100% { transform: scale(1) rotate(0); }
  }
  @keyframes calm { 0%, 44% { opacity: 1; } 46.5%, 86% { opacity: 0; } 92%, 100% { opacity: 1; } }
  @keyframes shock { 0%, 44% { opacity: 0; } 46.5%, 86% { opacity: 1; } 92%, 100% { opacity: 0; } }
  @keyframes flicker { from { transform: scaleY(.8); } to { transform: scaleY(1.12); } }
  @keyframes steam {
    0% { opacity: 0; transform: translateY(8px); }
    40% { opacity: 1; }
    100% { opacity: 0; transform: translateY(-14px); }
  }

  /* Reduced motion: show the boiled-over frame, static. */
  @media (prefers-reduced-motion: reduce) {
    .boilover *, .boilover { animation: none !important; }
    .foam { transform: scaleY(1); }
    .calm { opacity: 0; } .shock { opacity: 1; }
    .spill { stroke-dashoffset: 0; }
    .drop, .steam { display: none; }
  }
</style>
